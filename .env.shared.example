# Copy to .env only after rotating ALL existing demo account passwords in the local UI.
# Do not commit .env. Generate both secrets with a password manager or crypto RNG.
APP_ENV=staging
DEBUG=false
API_BIND_ADDRESS=127.0.0.1
POSTGRES_DB=zhituo
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_32_PLUS_CHARS
JWT_SECRET_KEY=REPLACE_WITH_INDEPENDENT_RANDOM_32_PLUS_CHARS
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_DEMO_USERS=false
BOOTSTRAP_DEMO_USER_PASSWORD=
REFRESH_COOKIE_SECURE=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
LAN_BIND_IP=192.168.1.10
SHARED_HOST=192.168.1.10
TRUSTED_HOSTS=192.168.1.10,localhost,127.0.0.1,api
CORS_ORIGINS=https://192.168.1.10:8443
