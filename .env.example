APP_NAME=智拓商机作战助手 API
APP_ENV=local
API_BIND_ADDRESS=127.0.0.1
DEBUG=true
API_V1_PREFIX=/api/v1
FRONTEND_DIR=
DATABASE_URL=postgresql+psycopg://zhituo:zhituo_dev@127.0.0.1:5432/zhituo
REDIS_URL=redis://127.0.0.1:6379/0
CORS_ORIGINS=http://127.0.0.1:8766,http://localhost:8766,http://127.0.0.1:5173,http://localhost:5173
TRUSTED_HOSTS=127.0.0.1,localhost
JWT_SECRET_KEY=please-change-this-before-shared-testing
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_SECURE=false

# Local bootstrap account. Change the password before shared testing.
BOOTSTRAP_ADMIN_USERNAME=groupadmin
BOOTSTRAP_ADMIN_EMPLOYEE_NO=CMCC0001
BOOTSTRAP_ADMIN_DISPLAY_NAME=集团管理员
BOOTSTRAP_ADMIN_PASSWORD=szyd123456
BOOTSTRAP_DEMO_USERS=true
BOOTSTRAP_DEMO_USER_PASSWORD=szyd123456

# External services: keep real values only in .env or a secret manager.
# 企查查：填好后「企查查线索池」采集才是真实数据（缺省时接口返回 503）。
QCC_APP_KEY=
QCC_SECRET_KEY=
# 腾讯地图：留空则回退读取 map_and_company/TenCentApiKey.txt。
TENCENT_MAP_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
GLM_API_KEY=
KIMI_API_KEY=
CLAMAV_HOST=
CLAMAV_PORT=3310

# Legacy SQLite prototypes retained from main; keep their secrets out of Git.
ZHITUO_JWT_SECRET=replace-with-at-least-32-random-characters
ZHITUO_API_KEY_PEPPER=replace-with-at-least-32-random-characters
ZHITUO_BOOTSTRAP_PASSWORD=replace-with-a-strong-initial-password
ZHITUO_DB_PATH=data/zhituo.db
ZHITUO_ALLOWED_ORIGINS=http://127.0.0.1:8766
